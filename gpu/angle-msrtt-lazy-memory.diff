+    // A transient image is valid in any memory type, so only ask for lazy memory if one of the
+    // image's types has it.
+    bool useLazilyAllocatedMemory = false;
+    if (hasLazilyAllocatedMemory)
+    {
+        VkMemoryRequirements memoryRequirements;
