+static void
+haiku_readback(struct haiku_egl_surface *hgl_surf, struct pipe_context *pipe,
+               struct pipe_resource *res)
+{
+   BitmapHook *hook = (BitmapHook *)hgl_surf->fb->winsysContext;
+   if (hook == NULL || res == NULL)
+      return;
+
+   unsigned width = res->width0, height = res->height0;
+   BBitmap *&bitmap = hgl_surf->readback_bitmaps[hgl_surf->readback_next];
+   if (bitmap != NULL && (bitmap->Bounds().IntegerWidth() + 1 != (int32)width ||
+                          bitmap->Bounds().IntegerHeight() + 1 != (int32)height)) {
+      /* never delete the bitmap the view is showing */
+      BBitmap *shown = hook->SetBitmap(NULL);
+      if (shown != bitmap)
+         hook->SetBitmap(shown);
+      delete bitmap;
+      bitmap = NULL;
+   }
+   if (bitmap == NULL) {
+      bitmap = new BBitmap(BRect(0, 0, width - 1, height - 1), 0, B_RGBA32);
+      if (bitmap->InitCheck() != B_OK) {
+         delete bitmap;
+         bitmap = NULL;
+         return;
+      }
+   }
+
+   struct pipe_transfer *transfer = NULL;
+   const uint8_t *src = (const uint8_t *)pipe_texture_map(
+      pipe, res, 0, 0, PIPE_MAP_READ, 0, 0, width, height, &transfer);
+   if (src == NULL)
+      return;
+
+   uint8_t *dst = (uint8_t *)bitmap->Bits();
+   size_t dstStride = bitmap->BytesPerRow();
+   size_t rowBytes = width * 4;
+   for (unsigned y = 0; y < height; y++)
+      memcpy(dst + y * dstStride, src + y * transfer->stride, rowBytes);
+   pipe_texture_unmap(pipe, transfer);
+
+   /* the view hands back the previous bitmap, which we still own */
+   hook->SetBitmap(bitmap);
+   hgl_surf->readback_next ^= 1;
+}
