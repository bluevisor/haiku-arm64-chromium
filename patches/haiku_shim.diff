-  return new ShimWindow(frame, has_frame, with_toolbar, delegate);
+  // A popup is never decorated and never carries the toolbar, whatever the
+  // caller asked for its frame.
+  if (popup) {
+    has_frame = false;
+    with_toolbar = false;
+  }
+  return new ShimWindow(frame, has_frame, with_toolbar, popup, delegate);
 }
 
