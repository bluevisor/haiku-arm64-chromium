+namespace {
+
+struct SoundPlayerState {
+  HaikuShimSoundFillFunc fill;
+  void* cookie;
+  BSoundPlayer* player;
+  // Scratch for drivers that hand out 16-bit buffers.
+  float* scratch;
+  size_t scratch_frames;
+};
+
+void PlayBuffer(void* cookie, void* buffer, size_t size,
+                const media_raw_audio_format& format) {
+  SoundPlayerState* state = static_cast<SoundPlayerState*>(cookie);
+  const size_t channels = format.channel_count;
+  const size_t sample_size = format.format & media_raw_audio_format::B_AUDIO_SIZE_MASK;
+  if (channels == 0 || sample_size == 0) {
+    return;
+  }
+  const size_t frames = size / (channels * sample_size);
+  if (format.format == media_raw_audio_format::B_AUDIO_FLOAT) {
+    state->fill(state->cookie, static_cast<float*>(buffer), frames);
+    return;
+  }
+  if (state->scratch_frames < frames) {
+    delete[] state->scratch;
+    state->scratch = new float[frames * channels];
+    state->scratch_frames = frames;
+  }
+  state->fill(state->cookie, state->scratch, frames);
+  const size_t samples = frames * channels;
+  if (format.format == media_raw_audio_format::B_AUDIO_SHORT) {
+    int16* out = static_cast<int16*>(buffer);
+    for (size_t i = 0; i < samples; i++) {
+      float v = state->scratch[i];
+      v = v > 1.0f ? 1.0f : (v < -1.0f ? -1.0f : v);
+      out[i] = static_cast<int16>(v * 32767.0f);
+    }
+  } else if (format.format == media_raw_audio_format::B_AUDIO_INT) {
+    int32* out = static_cast<int32*>(buffer);
+    for (size_t i = 0; i < samples; i++) {
+      float v = state->scratch[i];
+      v = v > 1.0f ? 1.0f : (v < -1.0f ? -1.0f : v);
+      out[i] = static_cast<int32>(v * 2147483647.0f);
+    }
+  } else {
+    memset(buffer, 0, size);
+  }
+}
+
+}  // namespace
+
+extern "C" NativeSoundPlayer* HaikuShimSoundPlayerCreate(
+    int sample_rate, int channels, int frames_per_buffer,
+    HaikuShimSoundFillFunc fill, void* cookie) {
+  HaikuShimEnsureApp();
+  media_raw_audio_format format = media_raw_audio_format::wildcard;
+  format.frame_rate = sample_rate;
+  format.channel_count = channels;
+  format.format = media_raw_audio_format::B_AUDIO_FLOAT;
+  format.byte_order = B_MEDIA_HOST_ENDIAN;
+  format.buffer_size = frames_per_buffer * channels * sizeof(float);
+  SoundPlayerState* state = new SoundPlayerState{fill, cookie, NULL, NULL, 0};
+  state->player = new BSoundPlayer(&format, "Chromium", PlayBuffer, NULL, state);
+  if (state->player->InitCheck() != B_OK) {
+    delete state->player;
+    delete state;
+    return NULL;
+  }
+  return reinterpret_cast<NativeSoundPlayer*>(state);
+}
+
+extern "C" bool HaikuShimSoundPlayerStart(NativeSoundPlayer* player) {
+  SoundPlayerState* state = reinterpret_cast<SoundPlayerState*>(player);
+  if (state->player->Start() != B_OK) {
+    return false;
+  }
+  state->player->SetHasData(true);
+  return true;
+}
+
+extern "C" void HaikuShimSoundPlayerStop(NativeSoundPlayer* player) {
+  SoundPlayerState* state = reinterpret_cast<SoundPlayerState*>(player);
+  state->player->SetHasData(false);
+  state->player->Stop(true, true);
+}
+
+extern "C" void HaikuShimSoundPlayerSetVolume(NativeSoundPlayer* player,
+                                              float volume) {
+  reinterpret_cast<SoundPlayerState*>(player)->player->SetVolume(volume);
+}
+
+extern "C" int64_t HaikuShimSoundPlayerLatencyUs(NativeSoundPlayer* player) {
+  return reinterpret_cast<SoundPlayerState*>(player)->player->Latency();
+}
+
+extern "C" void HaikuShimSoundPlayerDestroy(NativeSoundPlayer* player) {
+  SoundPlayerState* state = reinterpret_cast<SoundPlayerState*>(player);
+  state->player->Stop(true, true);
+  delete state->player;
+  delete[] state->scratch;
+  delete state;
+}
+
