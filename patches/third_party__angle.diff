diff --git a/gni/angle.gni b/gni/angle.gni
index bde26da..b99ad7a 100644
--- a/gni/angle.gni
+++ b/gni/angle.gni
@@ -187,6 +187,9 @@ declare_args() {
 
   # Vulkan loader is statically linked on Mac unless the embedder specifies
   # otherwise. http://anglebug.com/40096682
+  # On Haiku this loads SwiftShader through volk: lib/libvulkan.so.1 is
+  # SwiftShader's libvk_swiftshader.so, and with angle_use_custom_libvulkan
+  # off no Vulkan loader (which has no Haiku port) is built.
   angle_shared_libvulkan = !is_mac || angle_shared_libvulkan_on_mac
 
   # There's no "is_winuwp" helper in BUILDCONFIG.gn, so we define one ourselves
@@ -230,7 +233,14 @@ declare_args() {
   angle_enable_gl =
       (ozone_platform_drm || ozone_platform_wayland || !is_linux ||
        ((angle_use_x11 && !is_chromeos) || angle_use_wayland || is_castos)) &&
-      !is_fuchsia && !angle_is_winuwp && !is_win_arm64 && !is_ios
+      !is_fuchsia && !angle_is_winuwp && !is_win_arm64 && !is_ios &&
+      # The "!is_linux" clause above means any non-Linux platform falls
+      # through to enabled by default, and Haiku has no GL driver: my Ozone
+      # backend already reports GetAllowedGLImplementations() as empty, so
+      # ANGLE's GL backend is dead code here, and libANGLE/Display.cpp's own
+      # #error "Unsupported OpenGL platform." fires once ANGLE_ENABLE_OPENGL
+      # gets defined for a platform its renderer/gl/ backend has no case for.
+      !is_haiku
 
   angle_enable_vulkan =
       angle_has_build &&
