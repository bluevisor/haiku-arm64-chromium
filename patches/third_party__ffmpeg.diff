diff --git a/libavutil/aarch64/cpu.c b/libavutil/aarch64/cpu.c
index b8d2bd3..cc8df08 100644
--- a/libavutil/aarch64/cpu.c
+++ b/libavutil/aarch64/cpu.c
@@ -20,6 +20,18 @@
 #include "libavutil/cpu_internal.h"
 #include "config.h"
 
+#if defined(__HAIKU__)
+/* Haiku maps to the shared linux ffmpeg config, which sets HAVE_GETAUXVAL=1.
+   Haiku has neither getauxval() nor elf_aux_info(), and no <sys/auxv.h>.
+   ffmpeg's own #else fallbacks are already correct for that case
+   (detect_flags() returns 0; ff_getauxval() sets ENOSYS), so correct the
+   define here rather than forking a whole Haiku config directory. */
+#undef HAVE_GETAUXVAL
+#define HAVE_GETAUXVAL 0
+#undef HAVE_ELF_AUX_INFO
+#define HAVE_ELF_AUX_INFO 0
+#endif
+
 #if HAVE_GETAUXVAL || HAVE_ELF_AUX_INFO
 #include <stdint.h>
 #include <sys/auxv.h>
