 		mapping = mmap(nullptr, length, prot, flags, -1, 0);
 	}
 
+	if(mapping == MAP_FAILED)
+	{
+		mapping = nullptr;
+	}
+#elif defined(__HAIKU__)
+	// Not from the heap as on other POSIX systems: libroot's page allocator
+	// faults writing a free-chunk header into heap pages that were
+	// mprotect'ed for JIT code and later freed.
+	mapping = mmap(nullptr, length, permissionsToMmapProt(permissions),
