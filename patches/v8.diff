diff --git a/src/base/debug/stack_trace_posix.cc b/src/base/debug/stack_trace_posix.cc
index 39fa8be2..ca2eb32c 100644
--- a/src/base/debug/stack_trace_posix.cc
+++ b/src/base/debug/stack_trace_posix.cc
@@ -64,6 +64,7 @@ namespace {
 volatile sig_atomic_t in_signal_handler = 0;
 bool dump_stack_in_signal_handler = true;
 
+#if HAVE_EXECINFO_H
 // The prefix used for mangled symbols, per the Itanium C++ ABI:
 // http://www.codesourcery.com/cxx-abi/abi.html#mangling
 const char kMangledSymbolPrefix[] = "_Z";
@@ -73,7 +74,6 @@ const char kMangledSymbolPrefix[] = "_Z";
 const char kSymbolCharacters[] =
     "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
 
-#if HAVE_EXECINFO_H
 // Demangles C++ symbols in the given text. Example:
 //
 // "out/Debug/base_unittests(_ZN10StackTraceC1Ev+0x20) [0x817778c]"
diff --git a/src/base/platform/platform-posix.cc b/src/base/platform/platform-posix.cc
index 7add12aa..7159de6a 100644
--- a/src/base/platform/platform-posix.cc
+++ b/src/base/platform/platform-posix.cc
@@ -74,7 +74,10 @@
 #include <sys/resource.h>
 #endif
 
-#if !defined(_AIX) && !defined(V8_OS_FUCHSIA) && !V8_OS_ZOS
+#if !defined(_AIX) && !defined(V8_OS_FUCHSIA) && !V8_OS_ZOS && \
+    !defined(V8_OS_HAIKU)
+// Haiku exposes no stable syscall numbers, and none of the POSIX paths
+// below reach for syscall() anyway.
 #include <sys/syscall.h>
 #endif
 
@@ -655,6 +658,10 @@ bool OS::DiscardSystemPages(void* address, size_t size) {
   if (ret != 0 && errno == EINVAL) {
     ret = madvise(reinterpret_cast<caddr_t>(address), size, MADV_DONTNEED);
   }
+#elif defined(V8_OS_HAIKU)
+  // Haiku's kernel ignores MADV_DONTNEED; its MADV_FREE discards the pages
+  // right away (they read back as zero), which is Linux's MADV_DONTNEED.
+  int ret = madvise(address, size, MADV_FREE);
 #else
   int ret = madvise(address, size, MADV_DONTNEED);
 #endif
@@ -676,11 +683,42 @@ bool OS::DecommitPages(void* address, size_t size) {
   // shall be removed, as if by an appropriate call to munmap(), before the new
   // mapping is established." As a consequence, the memory will be
   // zero-initialized on next access.
-  void* ret = mmap(address, size, PROT_NONE,
-                   MAP_FIXED | MAP_ANONYMOUS | MAP_PRIVATE, -1, 0);
+  int decommit_flags = MAP_FIXED | MAP_ANONYMOUS | MAP_PRIVATE;
+#ifdef V8_OS_HAIKU
+  // The range is about to hold nothing, so do not make the kernel find
+  // memory for it. Haiku's MAP_NORESERVE is documented as "don't commit
+  // memory", which is the whole intent here.
+  decommit_flags |= MAP_NORESERVE;
+#endif
+  void* ret = mmap(address, size, PROT_NONE, decommit_flags, -1, 0);
   if (V8_UNLIKELY(ret == MAP_FAILED)) {
     // Decommitting pages can fail if the limit of VMAs is exceeded.
     CHECK_EQ(ENOMEM, errno);
+#ifdef V8_OS_HAIKU
+    // Haiku cannot always replace the mapping: MAP_FIXED over a live
+    // range means deleting one area and creating another, and in a
+    // fragmented address space the new one is what runs out. The
+    // callers of this function do not need a new mapping; they need the
+    // range to stay reserved and to read back as zero. Do that in
+    // place. It leaves the pages resident, which is why it is the
+    // fallback and not the first choice -- but a resident page costs
+    // less than the CHECK(success) in BoundedPageAllocator::FreePages,
+    // which ends the process.
+    if (mprotect(address, size, PROT_READ | PROT_WRITE) == 0) {
+      memset(address, 0, size);
+      // Taking the permissions away again is what the mmap would have
+      // done. If Haiku cannot split the area for it, zeroed and
+      // writable still satisfies every caller.
+      mprotect(address, size, PROT_NONE);
+      static bool reported = false;
+      if (!reported) {
+        reported = true;
+        fprintf(stderr, "[RCH] DecommitPages: mmap came back ENOMEM; "
+                "zeroing in place instead\n");
+      }
+      return true;
+    }
+#endif
     return false;
   }
   CHECK_EQ(ret, address);
