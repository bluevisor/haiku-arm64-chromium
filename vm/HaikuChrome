#!/bin/sh
# Launcher for the full //chrome build (not R Chromium's content_shell).
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
cd "$(dirname "$self")" || exit 1
# lib/ holds the BeAPI shim and SwiftShader's Vulkan driver as libvulkan.so.1; venus/
# holds the Vulkan loader stand-in and Mesa's Venus driver, which forward Vulkan to
# the host GPU through virtio-gpu. ANGLE dlopens libvulkan.so.1 (through volk)
# for WebGL. HAIKUCHROME_SWIFTSHADER=1 falls back to software rendering.
if [ -n "$HAIKUCHROME_SWIFTSHADER" ]; then
	LIBRARY_PATH="%A/lib:$LIBRARY_PATH"
	angle="--use-angle=swiftshader --enable-unsafe-swiftshader"
else
	LIBRARY_PATH="%A/venus:%A/lib:$LIBRARY_PATH"
	angle="--use-angle=vulkan"
fi
# GPU compositing (Phase 4): viz renders every frame on the GPU through a
# readback surface. HAIKUCHROME_SOFTWARE_COMPOSITING=1 goes back to
# compositing in software (WebGL still on the GPU).
comp=
if [ -n "$HAIKUCHROME_SOFTWARE_COMPOSITING" ]; then
	comp="--disable-gpu-compositing"
fi
export LIBRARY_PATH
# Deskbar shows a running app with its executable's icon. A deploy from Linux
# drops BFS attributes, so put the icon back when it's missing.
if ! catattr BEOS:ICON ./Chromium >/dev/null 2>&1 && [ -f chrome.hvif ]; then
	addattr -t icon -f chrome.hvif BEOS:ICON ./Chromium
fi
dark=
if ./ui_is_dark 2>/dev/null; then
	dark="--force-dark-mode"
fi
# Haiku gives each team 256 fds by default; Chrome only raises its own limit
# on Apple/Linux/Android, and single-process mode needs far more.
ulimit -n 8192 2>/dev/null
# Crashes are caught by Chromium's own handler, so keep the last run's stderr
# (a "Received signal" trace ends it) where a Deskbar launch would lose it.
log=/boot/home/config/settings/HaikuChrome/chromium.log
[ -f "$log" ] && mv -f "$log" "$log.1"
exec ./Chromium --enable-logging=stderr --ozone-platform=haiku --no-sandbox --single-process \
	--in-process-gpu $comp \
	$angle \
	--use-fake-device-for-media-stream \
	--user-data-dir=/boot/home/config/settings/HaikuChrome \
	$dark "$@" 2> "$log"
